def button_filter(button):
   async def func(_, __, msg):
       return msg.text == button.text
   return filters.create(func, "ButtonFilter", button=button)

@bot.on_message(filters.command("start"))
async def start(bot, message):
    await message.reply("Добро пожаловать!",
                        reply_markup=keyboards.kb_main)
    await bot.send_message(message.chat.id, "Лови стикер")
    await bot.send_sticker(message.chat.id, "CAACAgIAAxkBAAERNENqA3TIn133ZqwZCx3Sntqr8zfyhgAClogAAoE08UmdF_43h2ZjvjsE")
    with open("user.json","r") as file:
        user= json.load(file)
        if str(message.from_user.id) not in user.keys():
            user[message.from_user.id]=100
            with open("users.json", "w") as file:
                json.dump(user, file)
    with open("user.json", "r") as file:
        user=json.load(file)
    if user[str(message.from_user.id)] >=10:
        await message.reply("Твой ход", reply_markup=keyboards.kb_main )
    else:
        await message.reply(f"Неватает средств.На твоём счету{user[str(message.from_user.id)]}. Минимальная сумма для игры - 1")

