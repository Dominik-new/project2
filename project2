@bot.on_callback_query()
async def handle_query(bot, query):
    if query.data=="start_guestion":
        await bot.answer_callback_query( query.id,text="Добро пожаловать в квест под названием выбери правильную дверь",show_alert=True)
        await query.message.reply_text("Ты стоишь перед двумя дверьми.""Какую из них ты выберешь?",  reply_markup=keyboards.inline_kb_choice_door)
        await query.message.delete()
    elif query.data=="left_door":
        await query.message.reply_text("Ты входишь в левую дверь. Перед тобой дракон.Твои действия:", reply_markup=keyboards.inline_kb_left_door)
        await query.message.delete()
    elif query.data=="right_door":
        await query.message.reply_text("Ты выбрал праильную дверь. Но надо выбрать только 1 вещь что бы выйти отсюда. Выбирай быстрее, а иначе всё рухнет:", reply_markup=keyboards.inline_kb_right_door)
        await query.message.delete()
    elif query.data=="kill_dragon":
        await bot.answer_callback_query(query.id,text="Ты дерёшся с драконом. Но он сильнее тебя. Ты стараешся но всё равно умираешь.ИГРА ОКОНЧЕНА!!", show_alert=True)
        await query.message.delete()
    elif query.data=="Crown_KIng_Artur":
       await bot.answer_callback_query(query.id, text="Ты выбрал корону которая даёт славу и бесконечные богатства. Ира окончена, вы прошли её. Поздравляю ты прошёл квест!", show_alert=True)
       await query.message.delete()
    elif query.data=="run":
        await bot.answer_callback_query(query.id, text="Ты выбрал правильное действие и ты нашёл выход", show_alert=True)
        await query.message.delete()
    elif query.data=="Eye_of_Sauron":
        await bot.answer_callback_query(query.id, text="Ты выбрал корону которая даёт славу и бесконечные богатства. Ира окончена, вы прошли её. Поздравляю ты прошёл квест!", show_alert=True)
        await query.message.delete()



bot.run()
